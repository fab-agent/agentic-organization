{
  "name": "@fab-agent/cli",
  "version": "0.1.0",
  "description": "3rdParty Agent Platform — 3pa workstation CLI",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "3pa": "./dist/3pa.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\"",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "npm run bundle"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@clack/prompts": "^0.8",
    "chalk": "^5",
    "execa": "^9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.24",
    "tsx": "^4",
    "typescript": "^5"
  },
  "keywords": [
    "ai",
    "agents",
    "self-hosted",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab-agent/agentic-organization.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist/3pa.mjs",
    "LICENSE"
  ]
}
